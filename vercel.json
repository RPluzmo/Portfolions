{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.7.1",
      "config": {
        "includeFiles": [
          "css/**",
          "js/**",
          "assets/**",
          "views/**",
          "controllers/**",
          "functions.php",
          "routes.php",
          "router.php"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}